# ════════════════════════════════════════════════════════════════════
#  Monebra Perfume — متغيّرات بيئة الإنتاج
#
#  انسخه إلى `.env` داخل مجلد المشروع على الخادم:
#     cp deploy/env.production.example .env
#     nano .env
#
#  ⚠️ لا ترفع هذا الملف بعد تعبئته إلى Git أبدًا.
#     صلاحياته يجب أن تكون لصاحب الخدمة وحده:
#     chmod 600 .env && chown monebra:monebra .env
# ════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات ──
# المحوّل يُختار من هذا الرابط تلقائيًا (src/lib/db-adapter.ts):
#   postgresql://…  ← PostgreSQL
#   file:…          ← SQLite (تطوير فقط)
#
# لا تنسَ تغيير provider في prisma/schema.prisma إلى "postgresql"
# — Prisma يقرأه وقت البناء فلا يقبل قيمة من البيئة.
DATABASE_URL="postgresql://monebra:كلمة_مرور_قوية@localhost:5432/monebra"

# ── سرّ الجلسات ──
# ⚠️ ولّده عشوائيًا، ولا تستخدم قيمة التطوير:
#     openssl rand -base64 32
# تغييره لاحقًا يُخرج كل المديرين من جلساتهم — وهو تصرّف مقصود.
AUTH_SECRET="ضع_هنا_ناتج_openssl_rand"

# ── عنوان الموقع ──
# ⚠️ يدخل في خريطة الموقع وrobots والبيانات المنظّمة وصور المشاركة على
# واتساب وفيسبوك. تركه على localhost يعني أن جوجل يفهرس عناوين لا وجود
# لها، وأن أي رابط تشاركه يظهر بلا صورة ولا عنوان.
# بـ https وبلا شرطة مائلة في آخره.
NEXT_PUBLIC_SITE_URL="https://monebra.ly"

# ── تخزين الصور ──
# محلي: يكتب في public/uploads داخل المشروع. يعمل على VPS لأن القرص دائم.
STORAGE_DRIVER="local"

# ── تحديد المعدّل ──
# اتركه فارغًا أو احذف السطر في الإنتاج. رفعه يُضعف الحماية من التخمين
# ومن إغراق الطلبات، ولا فائدة منه خارج الاختبارات الآلية.
# RATE_LIMIT_MULTIPLIER=1
