# ── قاعدة البيانات ──────────────────────────────────────────
# التطوير (SQLite)
DATABASE_URL="file:./prisma/dev.db"
# الإنتاج (PostgreSQL) — غيّر provider في prisma/schema.prisma إلى postgresql
# DATABASE_URL="postgresql://user:pass@host:5432/monebra?schema=public"

# ── الأمان ──────────────────────────────────────────────────
# مفتاح توقيع الجلسات — أنشئه بـ: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"

# ── الموقع ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── تخزين الصور ────────────────────────────────────────────
# local = القرص المحلي (VPS) | blob = تخزين سحابي (Vercel)
STORAGE_DRIVER="local"
